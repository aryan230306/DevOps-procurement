# Application Configuration
APP_NAME=ProcurePulse
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Database Configuration
# In docker-compose, this connects to the postgres container:
DATABASE_URL=postgresql+asyncpg://zycus_user:zycus_secure_pass_2026@db:5432/procurepulse
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Operations
SECRET_KEY=procurepulse-super-secret-key-change-in-production-min32chars
CHAOS_ENABLED=true
METRICS_ENABLED=true
RATE_LIMIT_PER_MINUTE=600

# Prometheus & SRE SLO Thresholds
SLO_TARGET_AVAILABILITY=0.999
SLO_TARGET_LATENCY_P95_MS=300

# Observability Ports
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
NGINX_PORT=80
SINK_PORT=9999
