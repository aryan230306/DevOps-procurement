# Application Configuration
APP_NAME=ProcurePulse
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Database Configuration
# In docker-compose, this connects to the postgres container:
DATABASE_URL=postgresql+asyncpg://procure_user:procure_secure_2026@db:5432/procurepulse
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Operations
SECRET_KEY=procurepulse-super-secret-key-change-in-production-min32chars
CHAOS_CONTROL_TOKEN=replace-with-a-random-secret-in-production
CORS_ALLOWED_ORIGINS=
CHAOS_ENABLED=true
METRICS_ENABLED=true
RATE_LIMIT_PER_MINUTE=600

# Optional browser-facing monitoring links. Leave empty if not publicly deployed.
GRAFANA_URL=
PROMETHEUS_URL=
ALERTMANAGER_URL=
ALERT_SINK_URL=

# Prometheus & SRE SLO Thresholds
SLO_TARGET_AVAILABILITY=0.999
SLO_TARGET_LATENCY_P95_MS=300

# Observability Ports
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
NGINX_PORT=80
SINK_PORT=9999
